{
  "expo": {
    "name": "HogarApp",
    "slug": "HogarApp",
    "scheme": "hogarapp",
    "version": "0.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "HOMI",
      "shortName": "HOMI",
      "description": "Organiza tu piso compartido: tareas, compra, chat y gastos.",
      "lang": "es",
      "themeColor": "#FCEFE6",
      "backgroundColor": "#FCEFE6",
      "display": "standalone",
      "orientation": "portrait",
      "favicon": "./public/icons/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-image",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCEFE6",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "releaseStage": "beta"
    }
  }
}
