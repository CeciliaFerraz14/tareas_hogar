{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Lo que no es código de la app. "exclude" sustituye al de expo/tsconfig.base,
  // así que repite sus entradas.
  //   · dist/: el build web (5 MB de JS minificado: TypeScript se colgaba)
  //   · supabase/functions/: código Deno (imports npm:), se revisa con Deno
  //   · public/: JavaScript del service worker, no pasa por Metro
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "dist",
    "web-build",
    "public",
    "supabase/functions"
  ]
}
